APP_DIR=/home/pi/pi-zero2wh-camera
HOST=127.0.0.1
WORKER_PORT=8091
WEB_PORT=8080
PI_IP=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Raspberry Pi Zero 2 W/WH low-memory camera profile
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
STREAM_FPS=6
JPEG_QUALITY=68
BUFFER_COUNT=4

# H.264 recording. The encoder runs continuously into a small circular
# compressed buffer so AI events can include video from before detection.
RECORD_BITRATE=4000000

# IMX500 / mini_ai_camera-inspired AI integration
AI_ENABLED=1
AI_MODEL_PATH=/home/pi/pi-zero2wh-camera/models/yolov8n.rpk
AI_LABELS_PATH=/home/pi/pi-zero2wh-camera/models/coco_labels.txt
AI_VALID_CLASSES=person,car,bird,cat,dog
AI_CONFIDENCE=0.50
AI_IOU_THRESHOLD=0.50
AI_IPS=5
AI_DRAW_BOXES=1

# EMA hysteresis avoids event start/stop flicker.
AI_EMA_ALPHA=0.25
AI_EVENT_ACTIVATE=0.60
AI_EVENT_DEACTIVATE=0.35

# AI event capture
AI_EVENT_VIDEO_ENABLED=1
AI_EVENT_IMAGE_ENABLED=1
AI_PREBUFFER_SECONDS=3
AI_POSTBUFFER_SECONDS=4
AI_EVENT_MAX_SECONDS=60
AI_EVENT_COOLDOWN_SECONDS=3

# Upstream optional asset download. The installer only downloads when the
# local model/labels are missing.
AI_MODEL_DOWNLOAD_URL=https://raw.githubusercontent.com/LukeDitria/mini_ai_camera/main/models/yolov8n.rpk
AI_LABELS_DOWNLOAD_URL=https://raw.githubusercontent.com/LukeDitria/mini_ai_camera/main/models/coco_labels.txt

# Automatically delete video files older than this many days.
VIDEO_RETENTION_DAYS=7

# If 1, installer forces dtoverlay=imx500 on Raspberry Pi OS.
FORCE_IMX500_OVERLAY=1

# Basic auth for nginx. Change before first install.
NGINX_BASIC_USER=pi
NGINX_BASIC_PASSWORD=CHANGE_ME
