APP_DIR=/home/pi/pi-zero2wh-camera
HOST=127.0.0.1
WORKER_PORT=8091
WEB_PORT=8080
PI_IP=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Raspberry Pi Zero 2 W/WH low-memory camera profile
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
STREAM_FPS=6
JPEG_QUALITY=68
BUFFER_COUNT=4

# Recording profile
RECORD_WIDTH=1920
RECORD_HEIGHT=1080
RECORD_FPS=15
RECORD_BITRATE=6000000

# Automatically delete video files older than this many days.
# The systemd timer runs the cleanup once per day.
# Snapshots/images are preserved.
VIDEO_RETENTION_DAYS=7

# If 1, installer forces dtoverlay=imx500 on Raspberry Pi OS
FORCE_IMX500_OVERLAY=1

# Basic auth for nginx. Change before install.
NGINX_BASIC_USER=pi
NGINX_BASIC_PASSWORD=CHANGE_ME
